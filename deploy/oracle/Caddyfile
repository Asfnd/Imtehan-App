# HTTPS via Let's Encrypt. Cloudflare: grey cloud (DNS only) on imtehan.com for first cert,
# or use Caddyfile.cloudflare-origin with an Origin Certificate (orange cloud OK).
# See ORACLE_DEPLOYMENT.md

www.imtehan.com {
	redir https://imtehan.com{uri} permanent
}

imtehan.com {
	# Static MCQ banks — served from disk, never touch Next/Supabase.
	handle /banks/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		header Access-Control-Allow-Origin "*"
	}

	handle {
		reverse_proxy web:3000
	}
}
