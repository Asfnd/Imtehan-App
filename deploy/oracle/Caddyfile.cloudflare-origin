# Cloudflare orange cloud: use Origin Certificate in ./certs/
# docker-compose: mount ./certs:/etc/caddy/certs:ro and swap Caddyfile to this file.

www.imtehan.com {
	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key
	redir https://imtehan.com{uri} permanent
}

imtehan.com {
	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

	# Static MCQ banks — disk only (same as azure-flexible). Never Next/Supabase.
	handle /banks/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		header Access-Control-Allow-Origin "*"
	}

	handle {
		reverse_proxy web:3000
	}
}
