# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for npm run import-mcqs (bulk INSERT bypasses RLS). Get from Supabase → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app
JWT_SECRET=your-jwt-secret-key-change-in-production

# Required in production: stable CSRF signing so tokens work across all serverless instances (contact form, quiz submit, /api/grade).
# Generate: openssl rand -hex 32
CSRF_SECRET=

# Resend API Configuration for Contact Form
RESEND_API_KEY=re_your_api_key_here

# Note: 
# 1. Sign up at https://resend.com
# 2. Get your API key from the dashboard
# 3. Add your domain and verify it (or use their test domain for development)

# Example:
# RESEND_API_KEY=re_123abc456def789ghi

# Meta Pixel (Facebook) — Events Manager → Data sources → your Pixel ID. Public; used client-side.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — Events Manager → Settings → Generate access token (secret; server-only).
# Required for /api/analytics/meta-capi deduplication with the browser pixel.
META_CAPI_ACCESS_TOKEN=

# Google Analytics Configuration
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Note:
# 1. Go to https://analytics.google.com
# 2. Create a new GA4 property for your website
# 3. Copy the Measurement ID (starts with G-)
# 4. Add it to your .env.local file

# Writing coach /api/grade — OpenRouter only (default chain uses free :free models; see lib/ai/runGradingCompletion.ts)
# Get OpenRouter key: https://openrouter.ai/ — never commit real keys.
OPENROUTER_API_KEY=
# Optional: comma-separated model IDs (strongest first). Default is free-tier chain (Hermes 405B, Qwen 3.6+, etc.).
# CSS Writing Coach only (overrides OPENROUTER_MODEL_CHAIN for examType=css):
# OPENROUTER_MODEL_CHAIN_CSS=nousresearch/hermes-3-llama-3.1-405b:free,qwen/qwen3.6-plus:free
# PMS Writing Coach only:
# OPENROUTER_MODEL_CHAIN_PMS=qwen/qwen3.6-plus:free,meta-llama/llama-3.3-70b-instruct:free
# Global fallback when exam-specific vars are unset:
# OPENROUTER_MODEL_CHAIN=qwen/qwen3.6-plus:free,meta-llama/llama-3.3-70b-instruct:free
# Optional: shown to OpenRouter as HTTP-Referer (your site URL)
# OPENROUTER_HTTP_REFERER=https://imtehan.com
# Max completion tokens per OpenRouter request (default 4096).
# OPENROUTER_MAX_TOKENS=4096

# Cloudflare R2 Storage Configuration
NEXT_PUBLIC_R2_CUSTOM_DOMAIN=www.imtehan.com

# Note:
# 1. This should be your R2 custom domain (without https://)
# 2. Make sure your R2 bucket is connected to this domain in Cloudflare dashboard
# 3. The domain must allow public access for PDFs to load