# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app
JWT_SECRET=your-jwt-secret-key-change-in-production

# Resend API Configuration for Contact Form
RESEND_API_KEY=re_your_api_key_here

# Note: 
# 1. Sign up at https://resend.com
# 2. Get your API key from the dashboard
# 3. Add your domain and verify it (or use their test domain for development)

# Example:
# RESEND_API_KEY=re_123abc456def789ghi

# Google Analytics Configuration
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Note:
# 1. Go to https://analytics.google.com
# 2. Create a new GA4 property for your website
# 3. Copy the Measurement ID (starts with G-)
# 4. Add it to your .env.local file

# Cloudflare R2 Storage Configuration
NEXT_PUBLIC_R2_CUSTOM_DOMAIN=www.imtehan.com

# Note:
# 1. This should be your R2 custom domain (without https://)
# 2. Make sure your R2 bucket is connected to this domain in Cloudflare dashboard
# 3. The domain must allow public access for PDFs to load