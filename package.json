    "export-two-line-pfp": "tsx scripts/export-two-line-pfp.ts",
    "test-grading": "tsx scripts/test-grading-provider.ts",
    "test-css-grading": "tsx scripts/test-css-grading-modes.ts",
    "test-is-active-premium": "tsx scripts/test-is-active-premium.ts",
    "test-premium-gates": "tsx scripts/test-premium-gates.ts",
    "test-deactivate-db": "tsx scripts/test-deactivate-expired-db.ts",
    "test-question-reports": "tsx scripts/test-question-reports-e2e.ts",
    "ping-search-engines": "tsx scripts/ping-search-engines.ts",
    "ping-search-engines:priority": "tsx scripts/ping-search-engines.ts --priority",
    "ping-search-engines:flush": "tsx scripts/ping-search-engines.ts --flush",
    "generate:seo-assets": "tsx scripts/generate-seo-assets.ts",
    "install-git-hooks": "bash scripts/install-git-hooks.sh",
    "auto-push": "bash scripts/auto-push.sh",
    "prepare": "bash scripts/install-git-hooks.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.969.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@vercel/analytics": "1.3.1",
    "@vercel/speed-insights": "^1.3.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.454.0",
    "next": "16.0.10",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.76",
    "zustand": "^5.0.9"
