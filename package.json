    "validate:quality": "npm run test-premium-gates && npm run compare:mobile-exams && npm run validate:bank-quality",
    "merge-commission-sources": "tsx scripts/merge-commission-sources-into-exam-syllabi.ts",
    "build-ai-syllabi": "tsx scripts/build-ai-syllabus-packages.ts",
    "fetch-portal-syllabi": "tsx scripts/fetch-portal-syllabus-caches.ts",
    "verify-pms-setup": "tsx scripts/verify-pms-setup.ts",
