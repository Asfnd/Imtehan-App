    "compare:mobile-exams": "tsx scripts/compare-mobile-exams.ts",
    "validate:bank-quality": "tsx scripts/validate-bank-quality.ts",
    "triage:reports": "tsx scripts/export-report-section-map.ts && python3 scripts/triage-question-reports.py",
