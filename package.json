{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/generate-seo-assets.ts && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "clean": "rm -rf .next",
    "setup-paper-type": "tsx scripts/setup-paper-type.ts",
    "upload-mcqs": "tsx scripts/upload-new-mcqs.ts",
    "delete-subjects": "tsx scripts/delete-uploaded-subjects.ts",
    "import-mcqs": "tsx scripts/import-mcqs-to-supabase.ts",
    "export-exam-syllabi": "tsx scripts/export-exam-syllabi-from-config.ts",
